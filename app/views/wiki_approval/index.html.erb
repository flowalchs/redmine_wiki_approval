<h2><%= @query.new_record? ? l(:label_wiki_approval_workflow_plural) : @query.name %></h2>

<%= @query.persisted? && @query.description.present? ?
      content_tag('p', @query.description, class: 'subtitle') : '' %>

<%= form_tag(@project ? wiki_approval_project_index_path(project_id: @project.id) : wiki_approval_index_path, method: :get, id: "query_form") do %>
  <%= render partial: "queries/query_form", locals: { query: @query } %>
<% end %>

<% if @records.empty? %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% else %>

  <%= render_query_totals(@query) %>

  <table class="list">
    <thead>
      <tr>
        <% @query.columns.each do |column| %>
          <%= column_header(@query, column) %>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% @records.each do |r| %>
        <% waw = r.current_wiki_aw %>
        <% project = r.wiki&.project %>
        <tr>
          <% @query.columns.each do |column| %>
            <td class="<%= column.css_classes %>">
              <%= wiki_approval_column_value(r, waw, project, column) %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
  <br>
  <span class="pagination"><%= pagination_links_full @entry_pages, @entry_count %></span>

<% end %>