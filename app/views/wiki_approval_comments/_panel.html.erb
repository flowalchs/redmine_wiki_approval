<% can_add = wiki_comments_can_add?(project) %>
<div class="rwa-comments-header">
  <%# tabs like the issue history %>
  <div class="tabs rwa-comments-tabs">
    <ul>
      <% { 'open' => summary[:open], 'resolved' => summary[:resolved], 'all' => summary[:open] + summary[:resolved] }.each do |filter, count| %>
        <li>
          <%= link_to safe_join([l("label_wiki_comments_filter_#{filter}"), content_tag(:span, count, class: 'badge badge-count')], ' '),
                      '#wiki-comments', class: "rwa-filter rwa-filter-#{filter}",
                      data: { action: 'wiki-comments#filter:prevent', wiki_comments_filter_param: filter } %>
        </li>
      <% end %>
    </ul>
    <%# above the tab line, so the line runs through %>
    <label class="rwa-comments-toggle">
      <input type="checkbox" data-wiki-comments-target="toggle" data-action="wiki-comments#toggleHighlights">
      <%= l(:label_wiki_comments_show_inline) %>
    </label>
  </div>
</div>

<div class="rwa-threads journals">
  <%# threads by creation time, the resolved tab orders them by group with css (resolved in this / earlier revisions) %>
  <% %w[current earlier].each do |group| %>
    <% if summary[:"resolved_#{group}"].to_i > 0 %>
      <h4 class="rwa-group rwa-group-<%= group %>"><%= l("label_wiki_comments_resolved_#{group}") %></h4>
    <% end %>
  <% end %>
  <% threads.each do |thread| %>
    <%= render partial: 'wiki_approval_comments/thread',
               locals: { thread: thread, page: page, project: project, version: version, can_add: can_add } %>
  <% end %>
  <p class="rwa-empty rwa-empty-open"><%= l(:label_wiki_comments_none_open) %></p>
  <p class="rwa-empty rwa-empty-resolved"><%= l(:label_wiki_comments_none_resolved) %></p>
  <p class="rwa-empty rwa-empty-all"><%= l(:label_no_data) %></p>
  <% if local_assigns[:newer].to_i > 0 %>
    <p class="rwa-newer-info">
      <%= l(:text_wiki_comments_newer, count: newer) %>
      <%= link_to l(:label_wiki_comments_show_current), project_wiki_page_path(project, page.title, anchor: 'wiki-comments') %>
    </p>
  <% end %>
</div>

<% if can_add %>
  <%# hidden at first, redmine focuses the first visible textarea on load %>
  <p class="rwa-page-comment-toggle">
    <%= link_to sprite_icon('comment', l(:label_wiki_comments_add_page_link)), '#wiki-comments', class: 'icon icon-comment',
                data: { action: 'wiki-comments#showPageForm:prevent' } %>
    <em class="info"><%= l(:text_wiki_comments_select_hint) %></em>
  </p>
  <%= form_tag(wiki_comments_url(page, project, version), method: :post, class: 'rwa-comment-form rwa-page-comment-form',
               hidden: true, data: { action: 'submit->wiki-comments#submit' }) do %>
    <%= text_area_tag 'text', '', id: nil, rows: 5, class: 'wiki-edit', data: wiki_comment_textarea_data, placeholder: l(:label_wiki_comments_add_page), required: true %>
    <p class="rwa-form-buttons">
      <%= submit_tag l(:button_wiki_comment_add), name: nil %>
      <button type="button" data-action="wiki-comments#cancelForm"><%= l(:button_cancel) %></button>
    </p>
  <% end %>

  <template data-wiki-comments-target="inlineForm">
    <%= form_tag(wiki_comments_url(page, project, version), method: :post, class: 'rwa-comment-form rwa-inline-form',
                 data: { action: 'submit->wiki-comments#submit' }) do %>
      <%= hidden_field_tag 'quote', '', id: nil %>
      <%= hidden_field_tag 'prefix', '', id: nil %>
      <%= hidden_field_tag 'suffix', '', id: nil %>
      <blockquote class="rwa-quote"></blockquote>
      <%= text_area_tag 'text', '', id: nil, rows: 5, class: 'wiki-edit', data: wiki_comment_textarea_data, placeholder: l(:label_wiki_comments_add_inline), required: true %>
      <p class="rwa-form-buttons">
        <%= submit_tag l(:button_wiki_comment_add), name: nil %>
        <button type="button" data-action="wiki-comments#closePopover"><%= l(:button_cancel) %></button>
      </p>
    <% end %>
  </template>
<% end %>
