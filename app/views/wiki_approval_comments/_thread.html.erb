<% status = thread.status_at(version) %>
<div class="rwa-thread rwa-thread-<%= status %><%= ' rwa-thread-inline' if thread.inline? %>"
     data-wiki-comments-target="thread"
     data-comment-id="<%= thread.id %>"
     data-status="<%= status %>"
     data-group="<%= thread.resolved_group(version) %>"
     <% if thread.inline? %>
     data-quote="<%= thread.quote %>" data-prefix="<%= thread.prefix %>" data-suffix="<%= thread.suffix %>"
     <% end %>>
  <% locals = { thread: thread, status: status, page: page, project: project, version: version, can_add: can_add } %>
  <%= render partial: 'wiki_approval_comments/comment', locals: locals.merge(comment: thread) %>
  <% thread.replies.each do |reply| %>
    <%= render partial: 'wiki_approval_comments/comment', locals: locals.merge(comment: reply) %>
  <% end %>

  <% if can_add %>
    <%= form_tag(wiki_comments_url(page, project, version), method: :post, class: 'rwa-comment-form rwa-reply-form',
                 hidden: true, data: { action: 'submit->wiki-comments#submit' }) do %>
      <%= hidden_field_tag 'parent_id', thread.id, id: nil %>
      <%= text_area_tag 'text', '', id: nil, rows: 5, class: 'wiki-edit', data: wiki_comment_textarea_data, placeholder: l(:label_wiki_comments_reply), required: true %>
      <p class="rwa-form-buttons">
        <%= submit_tag l(:button_reply), name: nil %>
        <button type="button" data-action="wiki-comments#cancelForm"><%= l(:button_cancel) %></button>
      </p>
    <% end %>
  <% end %>
</div>
